[Unit]
Description=Local Azure gateway for Claude Code
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
PartOf=docker.service
StartLimitIntervalSec=0
ConditionPathExists=/etc/credstore.encrypted/claude-azure-local.key

[Service]
LoadCredentialEncrypted=azure.key:/etc/credstore.encrypted/claude-azure-local.key
ExecStart=/usr/bin/python3 /etc/claude-azure-local/start.py
ExecStop=-/usr/bin/python3 /etc/claude-azure-local/container-control.py stop
ExecStopPost=-/usr/bin/python3 /etc/claude-azure-local/container-control.py remove
Restart=always
RestartSec=10
TimeoutStopSec=45
UMask=0077
NoNewPrivileges=yes
ProtectHome=yes
ProtectSystem=strict
PrivateTmp=yes
StandardOutput=null
StandardError=null

[Install]
WantedBy=multi-user.target
